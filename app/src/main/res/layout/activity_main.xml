<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="SPOTIFAST"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_library"
            style="@style/IconButton"
            android:contentDescription="@string/library"
            android:src="@drawable/ic_library" />

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/IconButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- Display tipo LCD (homenaje a los reproductores clásicos) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/lcd_panel"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginEnd="10dp"
            android:background="@color/bg"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time"
                    style="@style/Lcd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/duration"
                    style="@style/Lcd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/accent_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/badge"
                    style="@style/Lcd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/accent_dim"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/btn_like"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/like"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart_outline"
                    android:tint="@color/muted"
                    android:visibility="invisible" />
            </LinearLayout>

            <TextView
                android:id="@+id/title"
                style="@style/Lcd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Lcd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seek"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progressDrawable="@drawable/seek_track"
        android:thumb="@drawable/seek_thumb"
        android:splitTrack="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="1000" />

    <!-- Controles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_shuffle"
            style="@style/IconButton"
            android:contentDescription="@string/shuffle"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/btn_prev"
            style="@style/IconButton"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/prev"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/play_button"
            android:contentDescription="@string/play"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:tint="@color/bg" />

        <ImageButton
            android:id="@+id/btn_next"
            style="@style/IconButton"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_next" />

        <ImageButton
            android:id="@+id/btn_repeat"
            style="@style/IconButton"
            android:contentDescription="@string/repeat"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Lcd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOL"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/volume"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progressDrawable="@drawable/seek_track"
        android:thumb="@drawable/seek_thumb"
        android:splitTrack="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100" />
    </LinearLayout>

    <!-- Búsqueda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp">

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_search"
            style="@style/IconButton"
            android:layout_height="44dp"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <!-- Pestañas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_library"
            style="@style/Tab"
            android:text="@string/tab_library" />

        <TextView
            android:id="@+id/tab_search"
            style="@style/Tab"
            android:text="@string/tab_search" />

        <TextView
            android:id="@+id/tab_queue"
            style="@style/Tab"
            android:text="@string/tab_queue" />
    </LinearLayout>

    <!-- Título de la pantalla actual + atrás -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/page_back"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Resultados / biblioteca -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/panel_edge"
            android:dividerHeight="1dp"
            android:fastScrollEnabled="false" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- Con scroll: en pantallas chicas (480x800, típicas de Android 4.4) no se corta -->
        <ScrollView
            android:id="@+id/login_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_login"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/pill"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/login"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/login_note"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_pair"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/pill_outline"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/pair"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/pair_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/lcd"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/login_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/error"
                android:textSize="12sp" />
        </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
