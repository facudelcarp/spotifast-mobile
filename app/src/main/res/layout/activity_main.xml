<?xml version="1.0" encoding="utf-8"?>
<!--
  Diseño v2: navegación a pantalla completa + mini reproductor abajo.
  Tocar el mini reproductor abre "Sonando" (capa encima, sin otra Activity).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ===================================================== navegación -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SPOTIFAST"
                android:textColor="@color/accent"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btn_settings"
                style="@style/IconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <!-- Búsqueda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/search"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                android:tint="@color/muted" />

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Pestañas tipo "chip" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tab_library"
                style="@style/Tab"
                android:text="@string/tab_library" />

            <TextView
                android:id="@+id/tab_search"
                style="@style/Tab"
                android:text="@string/tab_search" />

            <TextView
                android:id="@+id/tab_queue"
                style="@style/Tab"
                android:text="@string/tab_queue" />
        </LinearLayout>

        <!-- Título de la pantalla + atrás -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/page_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Contenido -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:paddingBottom="8dp"
                android:scrollbarStyle="outsideOverlay" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <!-- Login (con scroll para pantallas chicas de Android 4.4) -->
            <ScrollView
                android:id="@+id/login_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <Button
                        android:id="@+id/btn_login"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:background="@drawable/pill"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:text="@string/login"
                        android:textAllCaps="false"
                        android:textColor="@color/bg"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/login_note"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_pair"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/pill_outline"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/pair"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/pair_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:textColor="@color/lcd"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/login_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@color/error"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Mini reproductor -->
        <LinearLayout
            android:id="@+id/mini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/mini_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/mini_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:max="1000"
                android:progressDrawable="@drawable/mini_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/mini_cover"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/thumb_bg"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mini_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mini_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/mini_play"
                    style="@style/IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/play"
                    android:padding="11dp"
                    android:src="@drawable/ic_play" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================================================== Sonando (capa) -->
    <ScrollView
        android:id="@+id/now_playing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/np_bg"
        android:clickable="true"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/np_close"
                    style="@style/IconButton"
                    android:layout_marginStart="-12dp"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_chevron_down" />

                <TextView
                    android:id="@+id/status_np"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/now_playing"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <!-- Carátula (cuadrada; el alto se ajusta en código) -->
            <ImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/thumb_bg"
                android:scaleType="centerCrop" />

            <!-- Display LCD: el sello retro de Spotifast -->
            <LinearLayout
                android:id="@+id/lcd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/lcd_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/time"
                    style="@style/Lcd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/duration"
                    style="@style/Lcd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/accent_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/badge"
                    style="@style/Lcd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Título + Me gusta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/muted"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_like"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/like"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart_outline"
                    android:tint="@color/muted"
                    android:visibility="invisible" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="-14dp"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressDrawable="@drawable/seek_track"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <!-- Controles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_shuffle"
                    style="@style/IconButton"
                    android:contentDescription="@string/shuffle"
                    android:src="@drawable/ic_shuffle" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_prev"
                    style="@style/IconButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/prev"
                    android:padding="12dp"
                    android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/play_button"
                    android:contentDescription="@string/play"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="@color/bg" />

                <ImageButton
                    android:id="@+id/btn_next"
                    style="@style/IconButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/next"
                    android:padding="12dp"
                    android:src="@drawable/ic_next" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_repeat"
                    style="@style/IconButton"
                    android:contentDescription="@string/repeat"
                    android:src="@drawable/ic_repeat" />
            </LinearLayout>

            <!-- Volumen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume"
                    android:tint="@color/muted" />

                <SeekBar
                    android:id="@+id/volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:progressDrawable="@drawable/seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
